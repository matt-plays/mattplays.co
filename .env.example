# Copy to .env.local only if you need to point at a different Sanity project
# or dataset. Neither is required: sanity/env.ts defaults to the production
# project, so a fresh clone renders the site with no env file at all.
NEXT_PUBLIC_SANITY_PROJECT_ID=nexjv4lx
NEXT_PUBLIC_SANITY_DATASET=production

# Required ONLY by the one-off migration scripts in scripts/migrate, which
# write to Sanity. Create one at https://sanity.io/manage with Editor rights.
# Never commit the value.
SANITY_API_WRITE_TOKEN=
